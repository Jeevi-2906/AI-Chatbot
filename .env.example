# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Configurable: e.g., gemini-3-flash-preview, gemini-2.5-flash)
GEMINI_MODEL=gemini-3-flash-preview

# Context Window Management (Last-N-messages sent to Gemini API)
MAX_HISTORY_MESSAGES=6

# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

